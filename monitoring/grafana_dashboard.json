    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "title": "Fatal Defects Detected by Code",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(judiq_fatal_defects_detected_total[5m])) by (defect_code)",
          "legendFormat": "{{defect_code}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
